{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Studio",
  "version": "0.1.0",
  "identifier": "local.claude.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Claude Studio",
    "shortDescription": "Claude Studio — ролики с Claude",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle/_studio/": "_studio/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}